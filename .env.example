# Personal AI Employee - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Vault Configuration
VAULT_PATH=./AI_Employee_Vault

# System Settings
DRY_RUN=true
DEV_MODE=true
LOG_LEVEL=DEBUG

# Gmail Settings
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_CREDENTIALS=/absolute/path/to/your/gmail/credentials.json

# WhatsApp Settings
WHATSAPP_SESSION_PATH=/absolute/path/to/your/whatsapp/session

# Rate Limiting (requests per hour)
MAX_EMAILS_PER_HOUR=10
MAX_PAYMENTS_PER_HOUR=3
MAX_MESSAGES_PER_HOUR=20

# Watcher Intervals (seconds)
GMAIL_INTERVAL=120
WHATSAPP_INTERVAL=30
FILESYSTEM_INTERVAL=10

# Ralph Wiggum Settings
RALPH_MAX_ITERATIONS=10